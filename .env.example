# Copy to `.env` for local use. Never commit `.env`.
# Names and safety comments only. Never put real API keys, passwords,
# story body, or model output in Git.

# Local Postgres via docker compose (node 1.2). Placeholders only — not a real secret.
# The FastAPI /healthz and /version routes do not read these yet.
POSTGRES_USER=slove
POSTGRES_PASSWORD=changeme
POSTGRES_DB=slove_context
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Example local URL using the placeholders above. Dummy values only.
DATABASE_URL=postgresql://slove:changeme@localhost:5432/slove_context

# One writing-model vendor only. Never commit a real key. Unused in node 1.2.
MODEL_API_KEY=

# Product language is Chinese only (MVP). Not a second-language switch.
APP_LANGUAGE=

# Local single-user monolith. Do not add a second project or user.
STORY_PROJECT_ID=
