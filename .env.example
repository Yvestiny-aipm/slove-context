# Copy to `.env` for local use. Never commit `.env`.
# Node 1.1 does not load these variables. Names and safety comments only.
# Never put real API keys, passwords, story body, or model output in Git.

# Unused until node 1.2. Do not treat this as a live database connection.
DATABASE_URL=

# One writing-model vendor only. Never commit a real key.
MODEL_API_KEY=

# Product language is Chinese only (MVP). Not a second-language switch.
APP_LANGUAGE=

# Local single-user monolith. Do not add a second project or user.
STORY_PROJECT_ID=
