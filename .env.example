# Copy to `.env` for local use. Never commit `.env`.
# Names and safety comments only. Never put real API keys, passwords,
# story body, or model output in Git.

# Local Postgres via docker compose (node 1.2). Placeholders only — not a real secret.
# The FastAPI /healthz and /version routes do not read these yet.
POSTGRES_USER=slove
POSTGRES_PASSWORD=changeme
POSTGRES_DB=slove_context
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Example local URL using the placeholders above. Dummy values only.
# Node 1.3 Alembic reads DATABASE_URL when applying migrations locally.
# Unit tests and /healthz do not connect. Dummy values only — not a real secret.
DATABASE_URL=postgresql+psycopg://slove:changeme@localhost:5432/slove_context

# One writing-model vendor only. Never commit a real key.
# Unused in node 3.2 (Fake Provider only; no live vendor HTTP).
MODEL_API_KEY=

# Node UI.4 DeepSeek Scene Draft only. Empty = that trigger refuses.
# Never put a real key here. Name only.
DEEPSEEK_API_KEY=

# Product language is Chinese only (MVP). Not a second-language switch.
APP_LANGUAGE=

# Local single-user monolith. Do not add a second project or user.
STORY_PROJECT_ID=

# Node UI.1 local Demo only. development allows Vite origins.
# production must not set SLOVE_CORS_ORIGINS=* .
SLOVE_ENV=development
SLOVE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
